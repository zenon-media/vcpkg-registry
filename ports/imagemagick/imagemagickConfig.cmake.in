# ImageMagick CMake config — generated by vcpkg overlay port.
# Provides IMPORTED targets:
#   ImageMagick::MagickCore
#   ImageMagick::MagickWand
#   ImageMagick::Magick++

# Guard against multiple inclusions.
if(TARGET ImageMagick::MagickCore)
    return()
endif()

# @_MagickCore_TARGET_NAME@
if("@_MagickCore_DEBUG_LOCATION@" OR "@_MagickCore_RELEASE_LOCATION@")
    add_library(@_MagickCore_TARGET_NAME@ SHARED IMPORTED)
    set_target_properties(@_MagickCore_TARGET_NAME@ PROPERTIES
                          IMPORTED_CONFIGURATIONS "Debug;Release"
                          INTERFACE_INCLUDE_DIRECTORIES "@_MagickCore_INCLUDE_DIRS@"
                          IMPORTED_LOCATION_DEBUG "@_MagickCore_DEBUG_LOCATION@"
                          IMPORTED_LOCATION_RELEASE "@_MagickCore_RELEASE_LOCATION@"
    )
    if(WIN32)
        set_target_properties(@_MagickCore_TARGET_NAME@ PROPERTIES
                              IMPORTED_IMPLIB_DEBUG "@_MagickCore_DEBUG_IMPLIB@"
                              IMPORTED_IMPLIB_RELEASE "@_MagickCore_RELEASE_IMPLIB@"
        )
    endif()
else()
    add_library(@_MagickCore_TARGET_NAME@ UNKNOWN IMPORTED)
    set_target_properties(@_MagickCore_TARGET_NAME@ PROPERTIES
                          IMPORTED_CONFIGURATIONS "Debug;Release"
                          INTERFACE_INCLUDE_DIRECTORIES "@_MagickCore_INCLUDE_DIRS@"
                          IMPORTED_LOCATION_DEBUG "@_MagickCore_DEBUG_IMPLIB@"
                          IMPORTED_LOCATION_RELEASE "@_MagickCore_RELEASE_IMPLIB@"
    )
endif()
set_target_properties(@_MagickCore_TARGET_NAME@ PROPERTIES
                      # Compile options (per-config)
                      INTERFACE_COMPILE_OPTIONS "$<IF:$<CONFIG:Debug>,@_MagickCore_COMPILE_OPTIONS_DEBUG@,@_MagickCore_COMPILE_OPTIONS_RELEASE@>"
                      # Compile definitions (per-config)
                      INTERFACE_COMPILE_DEFINITIONS "$<IF:$<CONFIG:Debug>,@_MagickCore_DEFINES_DEBUG@,@_MagickCore_DEFINES_RELEASE@>"
                      # Link options (per-config)
                      INTERFACE_LINK_OPTIONS "$<IF:$<CONFIG:Debug>,@_MagickCore_LINK_OPTIONS_DEBUG@,@_MagickCore_LINK_OPTIONS_RELEASE@>"
                      INTERFACE_LINK_LIBRARIES "$<IF:$<CONFIG:Debug>,@_MagickCore_SYSTEM_LIBS_DEBUG@,@_MagickCore_SYSTEM_LIBS_RELEASE@>"
)

